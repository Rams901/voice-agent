# Copy to .env and fill in.
# Retell dashboard -> API Keys -> create key.
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the mock DMS tool server (see tool_server/).
# Retell must be able to reach this. Two ways:
#
#   Quick tunnel (random hostname, dies when the script exits):
#     ./scripts/dev_tunnel.sh --deploy
#
#   Named tunnel (stable hostname — see CLOUDFLARE_TUNNEL_TOKEN below):
#     ./scripts/dev_tunnel.sh --deploy     # uses TOOLS_PUBLIC_URL
#
# The script exports the URL it is using, which overrides this value for that
# run (real environment wins over the file). Set it here to deploy from a
# shell that is not using the script.
#
# WARNING: a stale value here is how a deploy silently ships a dead URL. If you
# use a quick tunnel, prefer leaving this empty and always deploying through the
# script. A named tunnel makes this a fixed value you set once — which is the
# main reason to use one.
TOOLS_BASE_URL=

# --- Named tunnel (optional, recommended for repeated testing) -------------- #
# Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared.
# Copy the token here, and add a Public Hostname route on the tunnel pointing
# at http://localhost:8000. When both are set, the tunnel hostname is stable,
# so the flow only needs deploying once.
CLOUDFLARE_TUNNEL_TOKEN=
# The public hostname you configured on that tunnel. Required whenever
# CLOUDFLARE_TUNNEL_TOKEN is set: cloudflared does not report it, and the
# script will refuse to guess.
TOOLS_PUBLIC_URL=

# Which dealer profile to deploy (see frontdesk/dealer_profiles.py)
DEALER_ID=northgate-uk

# Optional: shared secret the flow sends to the tool server
TOOLS_SHARED_SECRET=
